theme_override_colors/font_color = Color(0.98, 0.85, 0.16, 1)
theme_override_constants/line_spacing = 12
theme_override_font_sizes/font_size = 38
text = "Em um futuro distante, dominado pela IA, o semestre chegou ao fim, mas uma maldição burocrática prendeu o campus inteiro em um ciclo sem saída de requisitos, filas e papelada.

Enquanto o prédio é tomado pela noite e pelos fantasmas dos alunos que nunca se formaram, apenas um estudante ousa atravessar o RU, a biblioteca e os laboratórios.

Seu objetivo é simples: sobreviver à madrugada, recuperar seu diploma e escapar antes da próxima matrícula..."
horizontal_alignment = 1
autowrap_mode = 3

